          "inputs": [
            {
              "op": "dash",
              "direction": "right"
            },
            {
              "op": "step",
              "action": "wait"
            },
            {
              "op": "step",
              "action": "wait"
            },
            {
              "op": "step",
              "action": "left"
            }
          ],
          "expected": [
            {
              "x": 2,
              "energy": 1,
              "tick": 1,
              "hp": 2
            },
            {
              "x": 2,
              "energy": 2,
              "tick": 2,
              "hp": 1
            },
            {
              "x": 2,
              "energy": 3,
              "tick": 3,
              "hp": 0
            },
            {
              "error": "game_over"
            }
          ]
        },
        {
          "id": "advancing-game--continuous-hazard--step-damage",
          "inputs": [
            {
              "op": "step",
              "action": "wait"
            },
            {
              "op": "step",
              "action": "right"
            },
            {
              "op": "step",
              "action": "right"
            },
            {
              "op": "dash",
              "direction": "right"
            }
          ],
          "expected": [
            {
              "x": 0,
              "energy": 3,
              "tick": 1,
              "hp": 3
            },
            {
              "x": 1,
              "energy": 2,
              "tick": 2,
              "hp": 3
            },
            {
              "x": 2,
              "energy": 1,
              "tick": 3,
              "hp": 2
            },
            {
              "error": "exhausted"
            }
          ]
        }
      ],
      "base_expected": {
        "advancing-game--hazard-after-movement": [
          {
            "x": 1,
            "energy": 2,
            "tick": 1,
            "hp": 3
          },
          {
            "x": 2,
            "energy": 1,
            "tick": 2,
            "hp": 2
          },
          {
            "x": 2,
            "energy": 2,
            "tick": 3,
            "hp": 1
          }
        ],
        "advancing-game--dash-and-exhaustion": [
          {
            "x": 2,
            "energy": 1,
            "tick": 1,
            "hp": 2
          },
          {
            "error": "exhausted"
          },
          {
            "x": 3,
            "energy": 0,
            "tick": 2,
            "hp": 2
          },
          {
            "error": "exhausted"
          }
        ],
        "advancing-game--terminal": [
          {
            "x": 2,
            "energy": 1,
            "tick": 1,
            "hp": 2
          },
          {
            "x": 2,
            "energy": 2,
            "tick": 2,
            "hp": 1
          },
          {
            "x": 2,
            "energy": 3,
            "tick": 3,
            "hp": 0
          },
          {
            "error": "game_over"
          },
          {
            "error": "game_over"
          },
          {
            "error": "game_over"
          },
          {
            "error": "game_over"
          },
          {
            "error": "invalid_input"
          }
        ]
      }
    },
    {
      "id": "advancing-game--fast-recharge",
      "requirements": [
        "wait restores 2 energy capped at 5 instead of 1 capped at 3. Initial energy remains 3; movement costs and hazard are unchanged."
      ],
      "probes": [
        {
          "id": "advancing-game--fast-recharge--new-cap",
          "inputs": [
            {
              "op": "step",
              "action": "wait"
            },
            {
