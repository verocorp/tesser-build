from __future__ import annotations

import contextlib
import typing

import tesser.testing as ts
import restate

import {{context}}.adapters.runtimes as runtimes
import {{context}}.application.client as client
import {{context}}.application.relays as relays


@ts.fake
class Fake{{Aggregate}}ApplicationClient(client.{{Aggregate}}ApplicationClient):

    def __init__(self) -> None:
        self.recorded: list[relays.{{Record}}Request] = []

    async def {{record}}(self, {{record}}_request: relays.{{Record}}Request) -> relays.{{Record}}Response:
        self.recorded.append({{record}}_request)
        return relays.{{Record}}Response({{identity}}={{record}}_request.{{identity}})


@ts.fake
class Fake{{Aggregate}}OrchestratorApplicationClient(client.{{Aggregate}}OrchestratorApplicationClient):

    def __init__(self) -> None:
        self.conducted: list[relays.{{Conduct}}Request] = []

    async def {{conduct}}(self, {{conduct}}_request: relays.{{Conduct}}Request) -> relays.{{Conduct}}Response:
        self.conducted.append({{conduct}}_request)
        return relays.{{Conduct}}Response({{identity}}={{conduct}}_request.{{identity}})


@ts.fake
class Fake{{Aggregate}}Workflow(client.{{Aggregate}}Workflow[restate.WorkflowContext]):

    def __init__(
        self, fake_{{aggregate}}_orchestrator_application_client: Fake{{Aggregate}}OrchestratorApplicationClient
    ) -> None:
        self._fake_{{aggregate}}_orchestrator_application_client = fake_{{aggregate}}_orchestrator_application_client
        self.opened: list[restate.WorkflowContext] = []

    @contextlib.asynccontextmanager
    async def invocation(
        self, restate_workflow_context: restate.WorkflowContext
    ) -> typing.AsyncIterator[Fake{{Aggregate}}OrchestratorApplicationClient]:
        self.opened.append(restate_workflow_context)
        yield self._fake_{{aggregate}}_orchestrator_application_client


class TestRestate{{Aggregate}}Runtime:

    def test_it_registers_one_actions_service_and_one_orchestrator_workflow(self) -> None:
        restate_{{aggregate}}_runtime = runtimes.Restate{{Aggregate}}Runtime(
            Fake{{Aggregate}}ApplicationClient(),
            Fake{{Aggregate}}Workflow(Fake{{Aggregate}}OrchestratorApplicationClient()),
        )

        registered = {
            restate_{{aggregate}}_runtime.{{aggregate}}_actions_service.name: sorted(
                restate_{{aggregate}}_runtime.{{aggregate}}_actions_service.handlers
            ),
            restate_{{aggregate}}_runtime.{{aggregate}}_orchestrator_workflow.name: sorted(
                restate_{{aggregate}}_runtime.{{aggregate}}_orchestrator_workflow.handlers
            ),
        }

        assert registered == {"{{Aggregate}}Actions": ["{{record}}"], "{{Aggregate}}Orchestrator": ["{{conduct}}"]}

    def test_every_registration_declares_a_bounded_retry_policy(self) -> None:
        restate_{{aggregate}}_runtime = runtimes.Restate{{Aggregate}}Runtime(
            Fake{{Aggregate}}ApplicationClient(),
            Fake{{Aggregate}}Workflow(Fake{{Aggregate}}OrchestratorApplicationClient()),
        )

        policies = [
            restate_{{aggregate}}_runtime.{{aggregate}}_actions_service.invocation_retry_policy,
            restate_{{aggregate}}_runtime.{{aggregate}}_orchestrator_workflow.invocation_retry_policy,
        ]

        assert [(policy.max_attempts, policy.on_max_attempts) for policy in policies if policy is not None] == [
            (5, "pause"),
            (5, "pause"),
        ]

    async def test_the_{{record}}_handler_hands_the_request_to_the_application_client(self) -> None:
        fake_{{aggregate}}_application_client = Fake{{Aggregate}}ApplicationClient()
        {{record}}_request = relays.{{Record}}Request({{#record_fields}}{{field}}={{sample}}{{comma}}{{/record_fields}})

        await runtimes.Restate{{Aggregate}}Runtime(
            fake_{{aggregate}}_application_client,
            Fake{{Aggregate}}Workflow(Fake{{Aggregate}}OrchestratorApplicationClient()),
        ).{{record}}_handler(typing.cast(restate.Context, None), {{record}}_request)

        assert fake_{{aggregate}}_application_client.recorded == [{{record}}_request]

    async def test_the_{{conduct}}_handler_opens_the_workflow_on_this_invocations_context(self) -> None:
        fake_{{aggregate}}_workflow = Fake{{Aggregate}}Workflow(Fake{{Aggregate}}OrchestratorApplicationClient())
        restate_workflow_context = typing.cast(restate.WorkflowContext, object())

        await runtimes.Restate{{Aggregate}}Runtime(
            Fake{{Aggregate}}ApplicationClient(), fake_{{aggregate}}_workflow
        ).{{conduct}}_handler(
            restate_workflow_context,
            relays.{{Conduct}}Request({{#record_fields}}{{field}}={{sample}}{{comma}}{{/record_fields}}),
        )

        assert fake_{{aggregate}}_workflow.opened == [restate_workflow_context]

    async def test_the_{{conduct}}_handler_hands_the_request_to_the_orchestrator_the_workflow_opened(self) -> None:
        fake_{{aggregate}}_orchestrator_application_client = Fake{{Aggregate}}OrchestratorApplicationClient()
        {{conduct}}_request = relays.{{Conduct}}Request({{#record_fields}}{{field}}={{sample}}{{comma}}{{/record_fields}})

        restate_{{aggregate}}_runtime = runtimes.Restate{{Aggregate}}Runtime(
            Fake{{Aggregate}}ApplicationClient(), Fake{{Aggregate}}Workflow(fake_{{aggregate}}_orchestrator_application_client)
        )

        assert (
            await restate_{{aggregate}}_runtime.{{conduct}}_handler(
                typing.cast(restate.WorkflowContext, object()), {{conduct}}_request
            )
        ).{{identity}} == {{identity_sample}}
        assert fake_{{aggregate}}_orchestrator_application_client.conducted == [{{conduct}}_request]
