from __future__ import annotations

import typing

import tesser.adapters as ts
import restate
import restate.serde as restate_serde

import {{context}}.application.client as client
import {{context}}.application.relays as relays

_EMPTY_BODY: typing.Final[str] = "a message crosses the engine with a body"
_RETRY_POLICY: typing.Final[restate.InvocationRetryPolicy] = restate.InvocationRetryPolicy(
    max_attempts=5, on_max_attempts="pause"
)


class Restate{{Conduct}}RequestSerde(ts.Serde, restate_serde.Serde[relays.{{Conduct}}Request]):

    def serialize(self, {{conduct}}_request: relays.{{Conduct}}Request | None) -> bytes:
        if {{conduct}}_request is None:
            return b""
        return relays.{{Conduct}}RequestSnapshot().serialize({{conduct}}_request)

    def deserialize(self, buf: bytes) -> relays.{{Conduct}}Request | None:
        if not buf:
            raise restate.TerminalError(_EMPTY_BODY, status_code=400)
        return relays.{{Conduct}}RequestSnapshot().deserialize(buf)


class Restate{{Conduct}}ResponseSerde(ts.Serde, restate_serde.Serde[relays.{{Conduct}}Response]):

    def serialize(self, {{conduct}}_response: relays.{{Conduct}}Response | None) -> bytes:
        if {{conduct}}_response is None:
            return b""
        return relays.{{Conduct}}ResponseSnapshot().serialize({{conduct}}_response)

    def deserialize(self, buf: bytes) -> relays.{{Conduct}}Response | None:
