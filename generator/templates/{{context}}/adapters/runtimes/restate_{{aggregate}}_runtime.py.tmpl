class Restate{{Aggregate}}Runtime(ts.Runtime):

    def __init__(
        self,
        {{aggregate}}_application_client: client.{{Aggregate}}ApplicationClient,
        {{aggregate}}_workflow: client.{{Aggregate}}Workflow[restate.WorkflowContext],
    ) -> None:
        self.{{aggregate}}_actions_service = restate.Service(
            "{{Aggregate}}Actions", invocation_retry_policy=_RETRY_POLICY
        )
        self.{{aggregate}}_orchestrator_workflow = restate.Workflow(
            "{{Aggregate}}Orchestrator", invocation_retry_policy=_RETRY_POLICY
        )

        @self.{{aggregate}}_actions_service.handler(
            input_serde=Restate{{Record}}RequestSerde(),
            output_serde=Restate{{Record}}ResponseSerde(),
        )
        async def {{record}}(
            restate_context: restate.Context, {{record}}_request: relays.{{Record}}Request
        ) -> relays.{{Record}}Response:
            return await {{aggregate}}_application_client.{{record}}({{record}}_request)

        @self.{{aggregate}}_orchestrator_workflow.main(
            input_serde=Restate{{Conduct}}RequestSerde(),
            output_serde=Restate{{Conduct}}ResponseSerde(),
        )
        async def {{conduct}}(
            restate_workflow_context: restate.WorkflowContext, {{conduct}}_request: relays.{{Conduct}}Request
        ) -> relays.{{Conduct}}Response:
            async with {{aggregate}}_workflow.invocation(restate_workflow_context) as {{aggregate}}_orchestrator_application_client:
                return await {{aggregate}}_orchestrator_application_client.{{conduct}}({{conduct}}_request)

        self.{{record}}_handler = {{record}}
        self.{{conduct}}_handler = {{conduct}}
