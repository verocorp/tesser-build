from __future__ import annotations

import asyncio
import os
import socket
import typing
import uuid

import tesser.testing as ts
import httpx
import hypercorn.asyncio as hypercorn_asyncio
import hypercorn.config as hypercorn_config
import hypercorn.typing as hypercorn_typing
import pytest
import restate
import restate.client as restate_client

import {{context}}.adapters.activities as activities
import {{context}}.adapters.workflows as workflows
import {{context}}.application.client as client
import {{context}}.application.relays as relays


@ts.fake
class Fake{{Aggregate}}ApplicationClient(client.{{Aggregate}}ApplicationClient):

    def __init__(self) -> None:
        self.recorded: list[relays.{{Record}}Request] = []

    async def {{record}}(self, {{record}}_request: relays.{{Record}}Request) -> relays.{{Record}}Response:
        self.recorded.append({{record}}_request)
        return relays.{{Record}}Response({{identity}}={{record}}_request.{{identity}})


class TestRestate{{Conduct}}:

    async def test_{{conduct}}_calls_{{record}}_through_the_engine_and_answers_with_what_it_recorded(self) -> None:
        workflow_key = str(uuid.uuid4())
        suffix = uuid.uuid4().hex
        {{aggregate}}_actions_service = restate.Service(f"{{Aggregate}}Actions{suffix}")
        {{aggregate}}_orchestrator_workflow = restate.Workflow(f"{{Aggregate}}Orchestrator{suffix}")
        parent_target = f"{{Aggregate}}Orchestrator{suffix}/" + workflow_key + "/{{conduct}}"
        fake_{{aggregate}}_application_client = Fake{{Aggregate}}ApplicationClient()
        restate_{{conduct}} = workflows.Restate{{Conduct}}(
            {{aggregate}}_orchestrator_workflow,
            activities.Restate{{Record}}({{aggregate}}_actions_service, fake_{{aggregate}}_application_client),
        )
        with socket.socket() as probe:
            probe.bind(("0.0.0.0", 0))
            port = probe.getsockname()[1]
        hypercorn_config_config = hypercorn_config.Config()
        hypercorn_config_config.bind = [f"0.0.0.0:{port}"]
        shutdown = asyncio.Event()
        serving = asyncio.create_task(
            hypercorn_asyncio.serve(
                typing.cast(hypercorn_typing.ASGIFramework, restate.app([{{aggregate}}_actions_service, {{aggregate}}_orchestrator_workflow])),
                hypercorn_config_config,
                shutdown_trigger=shutdown.wait,
            )
        )
        admin = httpx.AsyncClient(base_url=os.environ["RESTATE_ADMIN"], timeout=10.0)
        registered = httpx.Response(503)
        try:
            for _ in range(50):
                registered = await admin.post(
                    "/deployments",
                    json={"uri": f"http://{os.environ['RESTATE_CALLBACK_HOST']}:{port}", "force": True},
                )
                if registered.is_success:
                    break
                await asyncio.sleep(0.1)
            assert registered.is_success, registered.text

            async with httpx.AsyncClient(base_url=os.environ["{{ingress_env}}"], timeout=30.0) as async_client:
                with pytest.raises(restate.HttpError) as foreign:
                    await restate_client.Client(async_client).workflow_call(
                        restate_{{conduct}}.handler, key="other-" + workflow_key, arg=relays.{{Conduct}}Request({{#record_fields}}{{field}}={{#is_identity}}workflow_key{{/is_identity}}{{^is_identity}}{{sample}}{{/is_identity}}{{comma}}{{/record_fields}})
                    )
                {{conduct}}_response = await restate_client.Client(async_client).workflow_call(
                    restate_{{conduct}}.handler, key=workflow_key, arg=relays.{{Conduct}}Request({{#record_fields}}{{field}}={{#is_identity}}workflow_key{{/is_identity}}{{^is_identity}}{{sample}}{{/is_identity}}{{comma}}{{/record_fields}})
                )
            invoked = await admin.post(
                "/query",
                headers={"accept": "application/json"},
                json={
                    "query": "SELECT target, completion_result FROM sys_invocation "
                    "WHERE invoked_by_target = '" + parent_target + "'"
                },
            )

            assert foreign.value.status_code == 400
            assert {{conduct}}_response == relays.{{Conduct}}Response({{identity}}=workflow_key)
            assert [recorded.{{identity}} for recorded in fake_{{aggregate}}_application_client.recorded] == [workflow_key]
            assert [(row["target"], row["completion_result"]) for row in invoked.json()["rows"]] == [
                (f"{{Aggregate}}Actions{suffix}/{{record}}", "success")
            ]
        finally:
            if registered.is_success:
                await admin.delete(f"/deployments/{registered.json()['id']}", params={"force": "true"})
            await admin.aclose()
            shutdown.set()
            await asyncio.wait([serving], timeout=1.0)
            serving.cancel()
            await asyncio.gather(serving, return_exceptions=True)
