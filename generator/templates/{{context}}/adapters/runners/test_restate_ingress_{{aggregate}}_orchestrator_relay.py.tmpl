from __future__ import annotations

import os
import uuid

import httpx

import {{context}}.adapters.runners as runners
import {{context}}.application.relays as relays


class TestRestateIngress{{Aggregate}}OrchestratorRelay:

    async def test_{{conduct}}_runs_the_workflow_the_engine_keys_by_the_{{identity}}(self) -> None:
        {{identity}} = str(uuid.uuid4())
        admin = os.environ.get("RESTATE_ADMIN", "http://localhost:9070")

        {{conduct}}_response = await runners.RestateIngress{{Aggregate}}OrchestratorRelay(
            os.environ["{{ingress_env}}"]
        ).run_{{conduct}}(
            relays.{{Conduct}}Request({{#record_fields}}{{field}}={{#is_identity}}{{field}}{{/is_identity}}{{^is_identity}}{{sample}}{{/is_identity}}{{comma}}{{/record_fields}})
        )

        async with httpx.AsyncClient(base_url=admin) as async_client:
            response = await async_client.post(
                "/query",
                headers={"accept": "application/json"},
                json={
                    "query": "SELECT target_service_name, target_service_key FROM sys_invocation "
                    "WHERE target = '{{Aggregate}}Orchestrator/" + {{identity}} + "/{{conduct}}'"
                },
            )

        assert {{conduct}}_response.{{identity}} == {{identity}}
        assert [
            (row["target_service_name"], row["target_service_key"]) for row in response.json()["rows"]
        ] == [("{{Aggregate}}Orchestrator", {{identity}})]
