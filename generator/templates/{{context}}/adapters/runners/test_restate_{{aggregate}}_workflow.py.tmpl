from __future__ import annotations

import os
import typing
import uuid

import httpx
import restate

import {{context}}.adapters.runners as runners
import {{context}}.application.orchestrators as orchestrators
import {{context}}.application.relays as relays


class TestRestate{{Aggregate}}Workflow:

    async def test_an_invocation_yields_the_{{aggregate}}_orchestrator(self) -> None:
        async with runners.Restate{{Aggregate}}Workflow().invocation(
            typing.cast(restate.WorkflowContext, object())
        ) as {{aggregate}}_orchestrator:
            assert isinstance({{aggregate}}_orchestrator, orchestrators.{{Aggregate}}Orchestrator)

    async def test_an_invocation_calls_{{record}}_on_the_actions_service_as_a_call_the_engine_journals(self) -> None:
        {{identity}} = str(uuid.uuid4())
        admin = os.environ.get("RESTATE_ADMIN", "http://localhost:9070")
        parent_target = "{{Aggregate}}Orchestrator/" + {{identity}} + "/{{conduct}}"

        await runners.RestateIngress{{Aggregate}}OrchestratorRelay(os.environ["{{ingress_env}}"]).run_{{conduct}}(
            relays.{{Conduct}}Request({{#record_fields}}{{field}}={{#is_identity}}{{field}}{{/is_identity}}{{^is_identity}}{{sample}}{{/is_identity}}{{comma}}{{/record_fields}})
        )

        async with httpx.AsyncClient(base_url=admin) as async_client:
            response = await async_client.post(
                "/query",
                headers={"accept": "application/json"},
                json={
                    "query": "SELECT target, invoked_by_service_name FROM sys_invocation "
                    "WHERE invoked_by_target = '" + parent_target + "'"
                },
            )

        assert [
            (row["target"], row["invoked_by_service_name"]) for row in response.json()["rows"]
        ] == [("{{Aggregate}}Actions/{{record}}", "{{Aggregate}}Orchestrator")]
