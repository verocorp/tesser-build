from __future__ import annotations

import typing

import tesser.component as ts
import restate

import {{context}}.adapters.activities as activities
import {{context}}.adapters.dispatchers as dispatchers
import {{context}}.adapters.repositories as repositories
import {{context}}.adapters.workflows as workflows
import {{context}}.application as application
import {{context}}.client as client
import pgdatabase.database as pgdatabase_database

_RETRY_POLICY: typing.Final[restate.InvocationRetryPolicy] = restate.InvocationRetryPolicy(
    max_attempts=5, on_max_attempts="pause"
)


class Spec(ts.Spec):

    def __init__(self, storage: str, ingress: str, identity_seed: int) -> None:
        self.storage = storage
        self.ingress = ingress
        self.identity_seed = identity_seed


class Config(ts.Config):

    def __init__(self, spec: Spec) -> None:
        self.storage = spec.storage
        self.ingress = spec.ingress
        self.identity_seed = spec.identity_seed
        self.database = pgdatabase_database.DatabaseRequest(spec.storage)


class {{Context}}(ts.Component):

    def __init__(self, config: Config, database: pgdatabase_database.Database) -> None:
        self._postgres_{{aggregate}}_store = repositories.Postgres{{Aggregate}}Store(database)
        self.{{aggregate}}_actions_service: restate.Service = restate.Service(
            "{{Aggregate}}Actions", ingress_private=True, invocation_retry_policy=_RETRY_POLICY
        )
        self.{{aggregate}}_orchestrator_workflow: restate.Workflow = restate.Workflow(
            "{{Aggregate}}Orchestrator", invocation_retry_policy=_RETRY_POLICY
        )
        restate_{{conduct}} = workflows.Restate{{Conduct}}(
            self.{{aggregate}}_orchestrator_workflow,
            activities.Restate{{Record}}(
                self.{{aggregate}}_actions_service, application.{{Aggregate}}Actions(self._postgres_{{aggregate}}_store)
            ),
        )
        self.client: client.{{Context}}Client = application.{{Aggregate}}Service(
            dispatchers.RestateHttp{{Aggregate}}OrchestratorRelay(config.ingress, restate_{{conduct}}),
            repositories.Uuid{{Aggregate}}IdentityRepository(config.identity_seed),
            self._postgres_{{aggregate}}_store,
        )

    async def close(self) -> None:
        return None
