            application.{{Aggregate}}Actions(self._postgres_{{aggregate}}_store)
        )
        self.client: client.{{Context}}Client = application.{{Aggregate}}Service(
            runners.RestateIngress{{Conduct}}Relay(config.ingress, self.restate_{{aggregate}}_runtime),
            repositories.Uuid{{Aggregate}}IdentityRepository(_IDENTITY_SEED),
            self._postgres_{{aggregate}}_store,
        )

    async def close(self) -> None:
        return None
