[importlinter]
root_packages =
    spike
    tesser
include_external_packages = False
unmatched_ignore_imports_alerting = error

[importlinter:contract:domain-is-a-leaf]
name = domain imports only tesser.domain
type = forbidden
allow_indirect_imports = true
source_modules =
    **.domain
    **.domain.**
forbidden_modules =
    **.application
    **.application.**
    **.adapters
    **.adapters.**
    **.client
    **.client.**
    tesser.application
    tesser.adapters
    tesser.context

[importlinter:contract:client-is-a-leaf]
name = the client DTOs import only tesser.context
type = forbidden
allow_indirect_imports = true
source_modules =
    **.client
    **.client.**
forbidden_modules =
    **.domain
    **.domain.**
    **.application
    **.application.**
    **.adapters
    **.adapters.**
    tesser.domain
    tesser.application
    tesser.adapters

[importlinter:contract:application-never-reaches-adapters]
name = application imports domain and client, never an adapter
type = forbidden
allow_indirect_imports = true
source_modules =
    **.application
    **.application.**
forbidden_modules =
    **.adapters
    **.adapters.**
    tesser.domain
    tesser.adapters
    tesser.context

[importlinter:contract:adapters-reach-only-domain]
name = an adapter imports domain, never application or client
type = forbidden
allow_indirect_imports = true
source_modules =
    **.adapters
    **.adapters.**
forbidden_modules =
    **.application
    **.application.**
    **.client
    **.client.**
    tesser.domain
    tesser.application
    tesser.context
