# gbrain machine-local artifacts (worktree pin + indexed-source data)
.gbrain-source
.sources/

# Python bytecode caches — generated by every pytest/analyzer run across
# tessercheck-py, roadmap/, and the examples/ trees.
__pycache__/
*.py[cod]

# Distribution artifacts from the tesser-py wheel gate (scripts/verify
# tesser-py). build/lib/ is a full duplicate of the source tree, and sigcheck
# walks every .py under its root with no exclusion list — a lingering copy from
# an interrupted run would change findings. The script cleans up after itself;
# this is the backstop.
dist/
build/
*.egg-info/

# Local verify environments (scripts/install-dev). The glob, not just .venv/:
# the tesser-py matrix runs three interpreters, so verifying it locally means
# three environments side by side.
.venv*/
