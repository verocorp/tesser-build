#!/usr/bin/env bash
# Local helper: run the analyzer over one tree with the worktree venv.
set -uo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export PATH="$ROOT/.venv/bin:$PATH"
export PYTHONPATH="$ROOT/tessercheck-py:$ROOT/tesser-py"
cd "$ROOT/tessercheck-py" || exit 1
exec python3 -m srv.cli.main "$ROOT/$1"
