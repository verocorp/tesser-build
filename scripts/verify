#!/usr/bin/env bash
#
# Every Python gate CI runs, runnable locally, one command per tree.
#
#   scripts/verify              all trees
#   scripts/verify python-app   one tree
#   scripts/verify serdepy python-app
#
# Each CI job calls this with its own tree, so the commands live here — in the
# repo, reviewable — rather than inline in workflow YAML. That is the point:
# "green locally" and "green in CI" have to mean the same thing, and they only
# do if there is one definition of what green is.
#
# Tools are taken from PATH, exactly as in CI. Install them into the active
# environment with scripts/install-dev.
#
# The Go gates are deliberately not here — go test, go vet, gofmt, and the
# golangci-lint plugin bundling job stay in the workflow.
#
# `roadmap` is not here either, and that is not an oversight: it is a Go/Python
# hybrid, not a Python tree. generate.py --check shells out to
# `go run ./cmd/analyzers-json` for the checker column, and 2 of its 32 tests
# go through the same bridge. Putting it here would mean a gate that cannot
# pass without the Go toolchain, which is exactly the kind of half-run this
# script exists to eliminate. It stays a workflow job.
set -uo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT" || exit 1

# Step 0 is the layout app (layout/ — a full tesser app with its own gates):
# it fails when the directories on disk, manifest.json, the .tesser-root
# files, and the CI jobs disagree in any direction. The tree list also comes
# from the layout app, never hand-maintained here: an `app` manifest row IS
# the claim that scripts/verify runs that tree, and a manifest tree with no
# run_* arm below fails as "unknown tree" rather than silently not running.
(cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.check "$ROOT") || exit 1

# Capture the output in a variable first: a python3 failure inside process
# substitution would be invisible, and an empty TREES list would make the
# loop below report "all green (0 trees)" — a check that passes without
# checking anything.
TREE_LIST=$( (cd "$ROOT/layout" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.trees "$ROOT") ) || { echo "verify: could not derive trees from manifest.json" >&2; exit 1; }
mapfile -t TREES <<<"$TREE_LIST"
if [ ${#TREES[@]} -eq 0 ] || [ -z "${TREES[0]}" ]; then
  echo "verify: no gated trees derived from manifest.json" >&2
  exit 1
fi

failed=()

step() { echo "  → $*"; }

# The analyzer is an app, and an app is run through its host: tessercheck-py's
# srv/cli/main.py. It runs from tessercheck-py's own directory — `-m
# srv.cli.main` resolves against the current directory first, and a checked
# tree may have an srv package of its own — so the tree to check is an
# argument, not the working directory.
tessercheck_tree() {
  (cd "$ROOT/tessercheck-py" && PYTHONPATH=.:../tesser-py python3 -m srv.cli.main "$1")
}

run_llmport() {
  cd "$ROOT/examples/llmport" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict scheduling protocol srv/voice/router.py srv/voice/test_router.py conftest.py || return 1
  step "pytest"
  pytest -q || return 1
}

run_python_app() {
  cd "$ROOT/examples/python-app" || return 1
  step "ruff (env edge + exit edge + dead imports + F823)"
  ruff check . || return 1
  step "import-linter (import direction)"
  PYTHONPATH=. lint-imports || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict protocol kernel campaign linkpolicy reports bootstrap srv tests conftest.py || return 1
  step "pytest"
  pytest -q || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
}

# The canonical application-ports tree: one context, two ports, an enum outcome
# and a collection answer. The six rejected encodings it was chosen over are not
# here on purpose — four of them exist *because* they produce findings, so a
# zero-findings gate is the wrong shape for them. They stay executable on the
# spike/application-ports branch, and docs/design-application-ports.md carries
# the measurements.
run_ports() {
  cd "$ROOT/examples/ports" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict catalog || return 1
  step "pytest"
  pytest -q || return 1
}

run_serdepy() {
  cd "$ROOT/examples/serdepy" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict conftest.py parcel || return 1
  step "pytest"
  pytest -q || return 1
}

run_errorspy() {
  cd "$ROOT/examples/errorspy" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../../tesser-py mypy --strict storage conftest.py protocol campaign || return 1
  step "pytest"
  pytest -q || return 1
}

run_tesser_py() {
  cd "$ROOT/tesser-py" || return 1
  step "mypy --strict"
  mypy || return 1
  # The mutmut fixture projects are excluded from the tree's own mypy run
  # (each ships a package named vo, which would collide), so each gets its
  # own strict invocation here — the cross-package consumer check the
  # retired vobase job used to provide.
  step "mypy --strict (mutmut fixtures)"
  # --cache-dir=/dev/null: a .mypy_cache left inside a fixture would be
  # copytree'd into the mutation runs (the test ignores known junk dirs, but
  # not creating the junk is the honest half of that contract).
  for fixture in tests/ecosystem/mutmut/fixtures/*/; do
    (cd "$fixture" && MYPYPATH=../../../../..:. mypy --strict --cache-dir=/dev/null vo tests) || return 1
  done
  step "pytest"
  pytest -q || return 1
  step "built wheel ships every subpackage"
  # Clean before and after: `pip wheel` leaves build/ and *.egg-info/ behind,
  # and build/lib/ is a full duplicate of the source tree. tessercheck's reader
  # now prunes build/ and dist/, but *.egg-info is not in the skip set and a
  # clean tree is the honest baseline either way.
  rm -rf dist build ./*.egg-info
  trap 'rm -rf "$ROOT/tesser-py/dist" "$ROOT/tesser-py/build" "$ROOT"/tesser-py/*.egg-info' RETURN
  pip wheel --no-deps -w dist . > /dev/null || return 1
  python3 - <<'EOF' || return 1
import glob, pathlib, sys, zipfile
names = zipfile.ZipFile(glob.glob("dist/*.whl")[0]).namelist()
shipped = {n.split("/")[1] for n in names if n.startswith("tesser/") and n.count("/") == 2}
shipped |= {n.split("/")[1] for n in names if n.startswith("tesser/") and n.count("/") == 1 and n.endswith(".py")}
on_disk = {p.parent.name for p in pathlib.Path("tesser").glob("*/__init__.py")}
on_disk |= {p.name for p in pathlib.Path("tesser").glob("*.py") if p.name != "__init__.py"}
missing = on_disk - shipped
if missing:
    sys.exit(f"wheel omits subpackages or modules: {sorted(missing)}")
print(f"wheel ships: {sorted(on_disk)}")
EOF
}

run_layout() {
  cd "$ROOT/layout" || return 1
  step "tessercheck (zero findings over the whole tree)"
  tessercheck_tree "$PWD" || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy --strict repo protocol bootstrap srv conftest.py || return 1
  step "pytest"
  pytest -q || return 1
}

run_tessercheck_py() {
  cd "$ROOT/tessercheck-py" || return 1
  step "tessercheck (self-check over its own tree)"
  tessercheck_tree "$PWD" || return 1
  step "RULES.md drift gate"
  PYTHONPATH=.:../tesser-py python3 -m srv.cli.rules --check || return 1
  step "mypy --strict"
  MYPYPATH=.:../tesser-py mypy || return 1
  step "pytest"
  pytest -q || return 1
  step "import contracts"
  PYTHONPATH=.:../tesser-py lint-imports --no-cache || return 1
}

run_tree() {
  local tree=$1
  echo
  echo "=== $tree ==="
  case "$tree" in
    llmport)        run_llmport ;;
    python-app)     run_python_app ;;
    serdepy)        run_serdepy ;;
    ports)          run_ports ;;
    errorspy)       run_errorspy ;;
    tesser-py)      run_tesser_py ;;
    layout)         run_layout ;;
    tessercheck-py) run_tessercheck_py ;;
    *) echo "unknown tree: $tree (known: ${TREES[*]})"; return 1 ;;
  esac
}

selected=("$@")
if [ ${#selected[@]} -eq 0 ]; then
  selected=("${TREES[@]}")
fi

for tree in "${selected[@]}"; do
  if run_tree "$tree"; then
    echo "  PASS $tree"
  else
    echo "  FAIL $tree"
    failed+=("$tree")
  fi
done

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all green (${#selected[@]} tree(s))"
  exit 0
fi
echo "FAILED: ${failed[*]}"
exit 1
