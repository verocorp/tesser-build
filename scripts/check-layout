#!/usr/bin/env python3
#
# The repo-layout check: manifest.json says what every top-level directory
# (and every examples/ subdirectory) is, and this script fails when the
# directories on disk and the manifest disagree — in either direction.
#
# Two kinds only, because everything is an app: `app` (a Python tree that
# scripts/verify runs) and `ungated` (not part of the Python gates; Go
# directories are covered by the Go jobs, not by this script). A word in a
# file can be typo'd, so the checks below don't rely on the word alone:
#   1. Every top-level directory has a manifest row, and every row a directory.
#   2. Same for examples/*.
#   3. A tree carries .tesser-root exactly when its scripts/verify arm runs
#      tessercheck — changing either side alone fails.
#   4. Every app row has a scripts/verify case arm and a CI job invoking it.
#   5. Every directory holding a requirements-dev.txt is an app row — a Python
#      tree cannot be filed under a kind that drops its gates.
#   6. A symlinked top-level or examples/* directory is a failure; inside a
#      declared tree, symlinks are the analyzer's TB045.
# This script looks at two directory levels by design; check 5 walks the
# whole repo, so a Python tree buried deeper is still caught.
import json
import pathlib
import re
import sys

SKIP_WALK = {
    ".git",
    ".claude",
    "__pycache__",
    ".venv",
    "venv",
    "env",
    ".env",
    ".mypy_cache",
    ".pytest_cache",
    ".tox",
    ".ruff_cache",
    "node_modules",
    "build",
    "dist",
    ".eggs",
}

HIDDEN_TRACKED = {".github"}

KINDS = frozenset({"app", "ungated"})


def fail(problems: list[str]) -> None:
    if problems:
        for problem in problems:
            print(f"layout: {problem}", file=sys.stderr)
        sys.exit(1)


def disk_dirs(base: pathlib.Path) -> set[str]:
    return {
        entry.name
        for entry in base.iterdir()
        if entry.is_dir()
        and entry.name not in SKIP_WALK
        and (not entry.name.startswith(".") or entry.name in HIDDEN_TRACKED)
    }


def walk_files(root: pathlib.Path, names: set[str]) -> dict[str, list[pathlib.Path]]:
    found: dict[str, list[pathlib.Path]] = {name: [] for name in names}
    pending = [root]
    while pending:
        base = pending.pop()
        for entry in sorted(base.iterdir()):
            if entry.name in SKIP_WALK:
                continue
            if entry.is_dir() and not entry.is_symlink():
                pending.append(entry)
            elif entry.name in names and not entry.is_dir():
                found[entry.name].append(entry)
    return found


def declared_app(path: pathlib.Path) -> tuple[bool, str]:
    try:
        text = path.read_text(encoding="utf-8-sig")
    except (UnicodeDecodeError, OSError) as error:
        return False, f"unreadable ({type(error).__name__})"
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    if not lines or lines[0] != "app":
        return False, "first line is not 'app'"
    return True, ""


def verify_arms(verify_text: str) -> dict[str, str]:
    arms: dict[str, str] = {}
    for match in re.finditer(r"^\s*([a-z0-9-]+)\)\s+(run_[a-z0-9_]+)\s", verify_text, re.MULTILINE):
        arms[match.group(1)] = match.group(2)
    return arms


def arm_body(verify_text: str, function: str) -> str:
    match = re.search(rf"^{function}\(\) {{\n(.*?)^}}", verify_text, re.MULTILINE | re.DOTALL)
    return match.group(1) if match else ""


def check(root: pathlib.Path) -> list[str]:
    problems: list[str] = []
    try:
        manifest = json.loads((root / "manifest.json").read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        return [f"manifest.json is unreadable: {error}"]
    if not isinstance(manifest, dict) or not all(
        isinstance(key, str) and isinstance(kind, str) for key, kind in manifest.items()
    ):
        return ["manifest.json is not a flat object of directory-path to kind strings"]

    for key, kind in sorted(manifest.items()):
        if kind not in KINDS:
            problems.append(f"manifest.json row '{key}' declares unknown kind '{kind}'; the kinds are 'app' and 'ungated'")

    top_rows = {key for key in manifest if "/" not in key}
    top_disk = disk_dirs(root)
    for name in sorted(top_disk - top_rows):
        problems.append(f"top-level directory '{name}' has no manifest.json row; every top-level directory declares what it is")
    for name in sorted(top_rows - top_disk):
        problems.append(f"manifest.json row '{name}' names no directory on disk")

    example_rows = {key.split("/", 1)[1] for key in manifest if key.startswith("examples/")}
    example_disk = disk_dirs(root / "examples") if (root / "examples").is_dir() else set()
    for name in sorted(example_disk - example_rows):
        problems.append(f"examples/{name} has no manifest.json row")
    for name in sorted(example_rows - example_disk):
        problems.append(f"manifest.json row 'examples/{name}' names no directory on disk")

    for key in sorted(top_rows | {f"examples/{name}" for name in example_rows}):
        if (root / key).is_symlink():
            problems.append(f"{key} is a symlinked directory; a declared directory is a real one")

    apps = {key for key, kind in manifest.items() if kind == "app"}
    try:
        verify_text = (root / "scripts" / "verify").read_text(encoding="utf-8")
    except OSError:
        verify_text = ""
        problems.append("scripts/verify is unreadable")
    try:
        workflow = (root / ".github" / "workflows" / "test.yml").read_text(encoding="utf-8")
    except OSError:
        workflow = ""
        problems.append(".github/workflows/test.yml is unreadable")

    arms = verify_arms(verify_text)
    names: dict[str, str] = {}
    tessercheck_gated: set[pathlib.Path] = set()
    for key in sorted(apps):
        tree = key.split("/")[-1]
        if tree in names:
            problems.append(f"'{key}' and '{names[tree]}' share the gate name '{tree}'; scripts/verify dispatches by basename, so app basenames must be unique")
        names[tree] = key
        if tree not in arms:
            problems.append(f"{key} has no scripts/verify case arm for '{tree}'")
        elif "tessercheck_tree" in arm_body(verify_text, arms[tree]):
            tessercheck_gated.add(root / key / ".tesser-root")
        if not re.search(rf"^\s*run: scripts/verify {re.escape(tree)}\s*$", workflow, re.MULTILINE):
            problems.append(f"{key} has no CI job step 'run: scripts/verify {tree}'")

    walked = walk_files(root, {".tesser-root", "requirements-dev.txt"})

    actual_roots = set(walked[".tesser-root"])
    for path in sorted(actual_roots - tessercheck_gated):
        problems.append(f"{path.relative_to(root)} declares a tree whose scripts/verify arm does not run tessercheck")
    for path in sorted(tessercheck_gated - actual_roots):
        problems.append(f"{path.relative_to(root)} is missing; a tessercheck-gated tree declares itself with .tesser-root")
    for path in sorted(tessercheck_gated & actual_roots):
        ok, reason = declared_app(path)
        if not ok:
            problems.append(f"{path.relative_to(root)} does not declare 'app': {reason}")

    for path in sorted(walked["requirements-dev.txt"]):
        key = str(path.parent.relative_to(root))
        if manifest.get(key) != "app":
            problems.append(f"{key} holds a requirements-dev.txt but is not an app row; a Python tree cannot sit outside the gates")

    return problems


def main() -> None:
    root = pathlib.Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else pathlib.Path(__file__).resolve().parent.parent
    problems = check(root)
    fail(problems)
    manifest = json.loads((root / "manifest.json").read_text(encoding="utf-8"))
    apps = sum(1 for kind in manifest.values() if kind == "app")
    print(f"layout: {len(manifest)} rows, {apps} app trees — disk, declarations, and gates agree")


if __name__ == "__main__":
    main()
